<Window x:Class="SurfaceTypeCoverManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SurfaceTypeCoverManager.UI.ViewModels"
        xmlns:views="clr-namespace:SurfaceTypeCoverManager.UI.Views"
        Title="Surface Type Cover Manager" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyboardViewModel}">
            <views:KeyboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TypingTestViewModel}">
            <views:TypingTestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionMonitorViewModel}">
            <views:ConnectionMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TouchpadViewModel}">
            <views:TouchpadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceInfoViewModel}">
            <views:DeviceInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventLogViewModel}">
            <views:EventLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Branding Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,14" BorderBrush="#2A3952" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⌨️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SURFACE TYPE COVER MANAGER" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="Diagnostic, Monitoring &amp; Hardware Management Suite" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Padding="10,4" CornerRadius="12" Background="#0F172A">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding DeviceStatus.StatusText}" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="#172033" BorderBrush="#2A3952" BorderThickness="0,0,1,0" Padding="10">
                <StackPanel>
                    <RadioButton Content="Dashboard" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" IsChecked="True" />
                    <RadioButton Content="Keyboard" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="Keyboard" />
                    <RadioButton Content="Typing Test" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="TypingTest" />
                    <RadioButton Content="Connection Monitor" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="ConnectionMonitor" />
                    <RadioButton Content="Touchpad" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="Touchpad" />
                    <RadioButton Content="Diagnostics" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" />
                    <RadioButton Content="Device Information" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="DeviceInfo" />
                    <RadioButton Content="Event Log" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="EventLog" />
                    <RadioButton Content="History" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="History" />
                    <Separator Background="#2A3952" Margin="4,10" />
                    <RadioButton Content="Settings" Style="{StaticResource NavTabButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>
            </Border>

            <!-- Active View Content Container -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="10" />
        </Grid>

        <!-- Bottom Footer Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" Padding="14,6" BorderBrush="#2A3952" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="Surface Type Cover Manager v1.0 | .NET 8 WPF | Win32 SetupAPI &amp; HID Telemetry" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                <TextBlock Text="CPU: &lt; 1% | RAM: &lt; 85MB | Event-Driven Active" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
