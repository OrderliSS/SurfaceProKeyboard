<UserControl x:Class="SurfaceTypeCoverManager.UI.Views.TypingTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Test Control Panel Card -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Surface Typing Performance Test" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Start Typing Test" Command="{Binding StartTestCommand}" Padding="16,8" Background="{StaticResource AccentCyanBrush}" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,8,0" />
                            <Button Content="Finish &amp; Save" Command="{Binding FinishTestCommand}" Padding="16,8" Background="{StaticResource AccentEmeraldBrush}" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Prompt Target Text -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <TextBlock Text="{Binding PromptText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap" LineHeight="24" />
                    </Border>

                    <!-- User Type Input Text Box -->
                    <TextBox Text="{Binding UserTypedText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10" SelectionBrush="{StaticResource AccentCyanBrush}" />
                </StackPanel>
            </Border>

            <!-- Metrics Statistics Bar -->
            <UniformGrid Columns="5">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Speed (WPM)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Wpm}" Foreground="{StaticResource AccentCyanBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Accuracy" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding AccuracyPercent}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="%" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Errors" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Errors}" Foreground="{StaticResource AccentRoseBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Avg. Latency" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding AverageLatencyMs}" Foreground="{StaticResource AccentAmberBrush}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text=" ms" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Ghost/Duplicates" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding DuplicatePresses}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Real-time Latency Chart -->
            <Border Style="{StaticResource CardPanel}" Margin="6,12,6,6">
                <StackPanel>
                    <TextBlock Text="Typing Latency Over Time (ms)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,12" />
                    <lvc:CartesianChart Series="{Binding LatencySeries}" Height="200" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
