<UserControl x:Class="SurfaceTypeCoverManager.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header Card -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <TextBlock Text="Application Settings &amp; Preferences" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                    <Button Content="Save Preferences" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" Padding="14,8" Background="{StaticResource AccentCyanBrush}" Foreground="#0F172A" FontWeight="Bold" />
                </Grid>
            </Border>

            <!-- Preferences Form Grid -->
            <UniformGrid Columns="2" Margin="0,10,0,0">
                <!-- Theme & Startup Settings -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Appearance &amp; Startup" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="Theme Preference" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Dark Mode" Command="{Binding SetDarkThemeCommand}" Padding="12,6" Background="#263449" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <Button Content="Light Mode" Command="{Binding SetLightThemeCommand}" Padding="12,6" Background="#334155" Foreground="White" FontWeight="SemiBold" />
                        </StackPanel>

                        <CheckBox Content="Start Automatically on Windows Boot" IsChecked="{Binding Settings.AutoStart}" Foreground="White" FontSize="13" Margin="0,0,0,12" />
                        <CheckBox Content="Minimize Application to System Tray" IsChecked="{Binding Settings.MinimizeToTray}" Foreground="White" FontSize="13" Margin="0,0,0,12" />
                    </StackPanel>
                </Border>

                <!-- Monitoring & Notifications -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Monitoring &amp; Retention" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,14" />

                        <CheckBox Content="Enable Real-Time Background PnP Monitoring" IsChecked="{Binding Settings.BackgroundMonitoring}" Foreground="White" FontSize="13" Margin="0,0,0,12" />
                        <CheckBox Content="Enable Windows Toast Notifications" IsChecked="{Binding Settings.EnableNotifications}" Foreground="White" FontSize="13" Margin="0,0,0,16" />

                        <TextBlock Text="Log Retention (Days)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Settings.LogRetentionDays}" Width="120" HorizontalAlignment="Left" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
