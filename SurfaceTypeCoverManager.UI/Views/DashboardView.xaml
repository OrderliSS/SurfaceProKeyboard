<UserControl x:Class="SurfaceTypeCoverManager.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header Banner -->
            <Border Style="{StaticResource CardPanel}" Background="#1E293B">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Surface Type Cover" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="{Binding Device.ModelName}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="12,6" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#064E3B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Device.IsConnected}" Value="False">
                                        <Setter Property="Background" Value="#881337" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Device.IsConnected, Converter={x:Null}}" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🟢" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Device.IsConnected}" Value="False">
                                                <Setter Property="Text" Value="🔴" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Device.StatusText}" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Metrics Grid -->
            <UniformGrid Columns="3" Margin="0,10,0,0">
                <!-- Hardware Identifiers Card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Hardware Specifications" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Vendor ID" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Device.VendorId}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="Product ID" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Device.ProductId}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="Firmware Version" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Device.FirmwareVersion}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="Serial Number" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Device.SerialNumber}" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Connection Metrics Card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Connection Telemetry" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Connection Duration" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding ConnectionDurationText}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

                        <TextBlock Text="Reconnect Count" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Device.ReconnectCount}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="Hardware ID" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Device.HardwareId}" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Lock & Status States Card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Device States" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Caps Lock" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Device.CapsLock}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Num Lock" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Device.NumLock}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Fn Lock" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Device.FnLock}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Backlight" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Device.BacklightStatus}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Touchpad" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Device.TouchpadStatus}" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Battery" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Device.BatteryStatus}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
