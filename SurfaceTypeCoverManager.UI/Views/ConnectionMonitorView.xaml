<UserControl x:Class="SurfaceTypeCoverManager.UI.Views.ConnectionMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Telemetry Cards -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Total Attach Events" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalArrivals}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Total Detach Events" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalRemovals}" Foreground="{StaticResource AccentRoseBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Total Reconnects" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalReconnects}" Foreground="{StaticResource AccentCyanBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Event History Table -->
            <Border Style="{StaticResource CardPanel}" Margin="6,12,6,6">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Connection Event Timeline" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                        <Button Content="Refresh Timeline" Command="{Binding LoadHistoryCommand}" HorizontalAlignment="Right" Padding="12,6" Background="#263449" Foreground="White" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding ConnectionEvents}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#172033" Foreground="White" BorderBrush="#334155" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" Height="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="160" />
                            <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="120" />
                            <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="200" />
                            <DataGridTextColumn Header="Hardware ID" Binding="{Binding HardwareId}" Width="220" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
