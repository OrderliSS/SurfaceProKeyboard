<UserControl x:Class="SurfaceTypeCoverManager.UI.Views.DeviceInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header Search Card -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SetupAPI Device Property Inspector" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="Complete low-level DEVPKEY properties queried via Windows SetupAPI" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Width="240" VerticalAlignment="Center" Padding="8,6" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                </Grid>
            </Border>

            <!-- Properties Grid -->
            <Border Style="{StaticResource CardPanel}" Margin="6,12,6,6">
                <DataGrid ItemsSource="{Binding DeviceProperties}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#172033" Foreground="White" BorderBrush="#334155" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" Height="460">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Device / Category" Binding="{Binding Category}" Width="220" />
                        <DataGridTextColumn Header="Property Name" Binding="{Binding PropertyName}" Width="200" />
                        <DataGridTextColumn Header="Property Value" Binding="{Binding PropertyValue}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
