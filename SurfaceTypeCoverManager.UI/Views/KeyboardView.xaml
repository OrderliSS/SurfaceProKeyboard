<UserControl x:Class="SurfaceTypeCoverManager.UI.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header Telemetry Bar -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Current Key" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding CurrentKey}" Foreground="{StaticResource AccentCyanBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Modifiers" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding ModifierState}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Polling Rate" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding PollingRateHz}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text=" Hz" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Est. Latency" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding EstimatedLatencyMs}" Foreground="{StaticResource AccentAmberBrush}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text=" ms" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Key Visualizer Keyboard Map Container -->
            <Border Style="{StaticResource CardPanel}" Margin="6,12,6,6">
                <StackPanel>
                    <TextBlock Text="Live Key Visualizer" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,16" />

                    <!-- Currently Active Keys Stream -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active Keys Pressed: " Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PressedKeysText}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Interactive ANSI Surface Keyboard Layout Matrix -->
                    <UniformGrid Columns="12" Height="220" Background="#0F172A" Margin="0,0,0,10">
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="Esc" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F6" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F7" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="Del" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="`" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="6" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="7" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="0" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="Backspace" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="Tab" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="Q" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="W" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="E" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="R" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="T" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="Y" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="U" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="I" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="O" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="P" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="\" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="Caps" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="A" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="S" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="D" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="F" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="G" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="H" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="J" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="K" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="L" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text=";" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Style="{StaticResource VisualKeyBorder}"><TextBlock Text="Enter" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Diagnostic Diagnostics Cards -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Ghosting Detection" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="{Binding IsGhostingDetected, Converter={x:Null}}" Margin="0,8,0,0" FontSize="16" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🟢 Clear (No Ghosting)" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGhostingDetected}" Value="True">
                                            <Setter Property="Text" Value="⚠️ Ghosting Signal Detected" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentRoseBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Stuck Key Detection" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="{Binding StuckKeysText}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="NKRO Rollover Test" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Max Keys Pressed: " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding MaxRollover}" Foreground="{StaticResource AccentCyanBrush}" FontSize="18" FontWeight="Bold" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
