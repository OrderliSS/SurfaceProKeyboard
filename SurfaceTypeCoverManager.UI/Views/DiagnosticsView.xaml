<UserControl x:Class="SurfaceTypeCoverManager.UI.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header Action Card -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Surface Hardware &amp; Driver Diagnostics" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Run Diagnostics Scan" Command="{Binding RunDiagnosticsCommand}" Padding="18,10" Background="{StaticResource AccentCyanBrush}" Foreground="#0F172A" FontWeight="Bold" />
                </Grid>
            </Border>

            <!-- Health Summary & Export Bar -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Health Items List -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="System Health Verification" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding HealthCheckItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}" Foreground="White" FontSize="13" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Export Package Controls -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Report Exporter" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,12" />
                        <Button Content="Export JSON Report" Command="{Binding ExportJsonCommand}" Margin="0,0,0,8" Padding="12,8" Background="#263449" Foreground="White" FontWeight="SemiBold" />
                        <Button Content="Export HTML Report" Command="{Binding ExportHtmlCommand}" Margin="0,0,0,8" Padding="12,8" Background="#263449" Foreground="White" FontWeight="SemiBold" />
                        <Button Content="Export ZIP Bundle" Command="{Binding ExportZipBundleCommand}" Padding="12,8" Background="{StaticResource AccentEmeraldBrush}" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Surface Services Table -->
            <Border Style="{StaticResource CardPanel}" Margin="6,12,6,6">
                <StackPanel>
                    <TextBlock Text="Surface Services &amp; Driver Infrastructure" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding Report.SurfaceServices}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#172033" Foreground="White" BorderBrush="#334155" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service Name" Binding="{Binding ServiceName}" Width="200" />
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="250" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
