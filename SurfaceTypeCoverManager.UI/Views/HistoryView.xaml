<UserControl x:Class="SurfaceTypeCoverManager.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header Card -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <TextBlock Text="SQLite Historical Diagnostic Database" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                    <Button Content="Refresh History Database" Command="{Binding RefreshHistoryCommand}" HorizontalAlignment="Right" Padding="12,6" Background="{StaticResource AccentCyanBrush}" Foreground="#0F172A" FontWeight="Bold" />
                </Grid>
            </Border>

            <TabControl Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                <!-- Typing History Tab -->
                <TabItem Header="Typing Sessions" Foreground="White" FontSize="14" FontWeight="Bold">
                    <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding TypingHistory}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#172033" Foreground="White" BorderBrush="#334155" Height="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                                <DataGridTextColumn Header="Speed (WPM)" Binding="{Binding Wpm}" Width="100" />
                                <DataGridTextColumn Header="Accuracy (%)" Binding="{Binding AccuracyPercent}" Width="100" />
                                <DataGridTextColumn Header="Total Chars" Binding="{Binding TotalChars}" Width="90" />
                                <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="80" />
                                <DataGridTextColumn Header="Avg Latency (ms)" Binding="{Binding AverageLatencyMs}" Width="120" />
                                <DataGridTextColumn Header="Max Latency (ms)" Binding="{Binding MaxLatencyMs}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <!-- Diagnostic History Tab -->
                <TabItem Header="Diagnostic Snapshots" Foreground="White" FontSize="14" FontWeight="Bold">
                    <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding DiagnosticHistory}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#172033" Foreground="White" BorderBrush="#334155" Height="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Generated At" Binding="{Binding GeneratedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160" />
                                <DataGridTextColumn Header="Status" Binding="{Binding IsHealthy}" Width="100" />
                                <DataGridTextColumn Header="HID Devices" Binding="{Binding HidDeviceCount}" Width="110" />
                                <DataGridTextColumn Header="Keyboards" Binding="{Binding KeyboardCount}" Width="110" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding SummaryText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
